{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Trexzo/SpawnPK-Client/schemas/javac-build-binding.schema.json",
  "title": "SpawnPK javac diagnostic build binding",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "binding_id",
    "tooling_commit",
    "build_id",
    "source_authority_sha256",
    "rebuild_id",
    "workspace_id",
    "source_tree_sha256",
    "diagnostic_report_id",
    "diagnostic_input_sha256",
    "frontier_id",
    "project_binary_fallback_count",
    "clean_rebuild_status",
    "clean_project_build",
    "identifiers_included",
    "note"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "javac_build_binding"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^JAVACBIND_[0-9A-F]{20}$"
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "source_authority_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rebuild_id": {
      "type": "string",
      "pattern": "^CLEANBUILD_[0-9A-F]{20}$"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "source_tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostic_report_id": {
      "type": "string",
      "pattern": "^JAVACDIAG_[0-9A-F]{20}$"
    },
    "diagnostic_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frontier_id": {
      "type": "string",
      "pattern": "^JAVACFRONTIER_[0-9A-F]{20}$"
    },
    "project_binary_fallback_count": {
      "const": 0
    },
    "clean_rebuild_status": {
      "enum": [
        "complete",
        "compile_failed",
        "class_set_mismatch"
      ]
    },
    "clean_project_build": {
      "type": "boolean"
    },
    "identifiers_included": {
      "const": false
    },
    "note": {
      "type": "string"
    },
    "tooling_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "additionalProperties": false
}
