{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Trexzo/SpawnPK-Client/schemas/source-name-review.schema.json",
  "title": "SpawnPK inferred source-name review",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "canonical",
    "review_id",
    "inventory_id",
    "source_tree_sha256",
    "summary",
    "proposals",
    "conflicts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "source_name_review"},
    "canonical": {"const": false},
    "review_id": {
      "type": "string",
      "pattern": "^SRCREVIEW_[0-9A-F]{20}$"
    },
    "inventory_id": {
      "type": "string",
      "pattern": "^SRCINV_[0-9A-F]{20}$"
    },
    "source_tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "summary": {"type": "object"},
    "proposals": {"type": "array"},
    "conflicts": {"type": "array"}
  }
}
