{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Trexzo/SpawnPK-Client/schemas/lineage.schema.json",
  "title": "SpawnPK client logical class lineage",
  "type": "object",
  "required": ["schema_version", "namespace", "id_format", "baseline_build_id", "builds", "classes", "unresolved"],
  "properties": {
    "schema_version": {"const": 1},
    "namespace": {"const": "spawnpk-client"},
    "id_format": {"const": "CLIENT_CLASS_%06d"},
    "baseline_build_id": {"type": "string", "minLength": 1},
    "builds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["build_id", "build_number", "sha256", "source_name", "authority"],
        "properties": {
          "build_id": {"type": "string", "minLength": 1},
          "build_number": {"type": ["integer", "null"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "source_name": {"type": "string"},
          "authority": {"enum": ["EXACT_CURRENT_CLIENT", "EXACT_HISTORICAL_CLIENT", "CROSS_BUILD", "RESEARCH", "INFERENCE"]}
        },
        "additionalProperties": false
      }
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["logical_id", "semantic_name", "semantic_status", "semantic_confidence", "lineage", "semantic_provenance"],
        "properties": {
          "logical_id": {"type": "string", "pattern": "^CLIENT_CLASS_[0-9]{6}$"},
          "semantic_name": {"type": ["string", "null"]},
          "semantic_status": {"enum": ["UNKNOWN", "CANDIDATE", "ACCEPTED"]},
          "semantic_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "lineage": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["build_id", "internal_name", "entry_path", "entry_sha256", "structural_sha256", "relation", "confidence", "provenance"],
              "properties": {
                "build_id": {"type": "string", "minLength": 1},
                "internal_name": {"type": "string", "minLength": 1},
                "entry_path": {"type": "string", "pattern": "\\.class$"},
                "entry_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
                "structural_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
                "relation": {"enum": ["BASELINE", "EXACT_HASH", "STRUCTURAL", "SEMANTIC", "MANUAL"]},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "provenance": {"type": "array"}
              },
              "additionalProperties": false
            }
          },
          "semantic_provenance": {"type": "array"}
        },
        "additionalProperties": false
      }
    },
    "unresolved": {"type": "array"}
  },
  "additionalProperties": false
}
