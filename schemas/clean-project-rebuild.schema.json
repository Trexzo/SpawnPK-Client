{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Trexzo/SpawnPK-Client/schemas/clean-project-rebuild.schema.json",
  "title": "SpawnPK clean project rebuild report",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "rebuild_id",
    "status",
    "workspace_id",
    "build_id",
    "source_authority_sha256",
    "readable_jar_sha256",
    "namespace_id",
    "source_tree_sha256",
    "build_authority_id",
    "source_scope",
    "compiler",
    "dependency_capsule",
    "project_classes",
    "diagnostic",
    "rebuilt_client",
    "clean_project_build",
    "all_dependencies_rebuilt_from_source",
    "note"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "clean_project_rebuild_report"},
    "rebuild_id": {"type": "string", "pattern": "^CLEANBUILD_[0-9A-F]{20}$"},
    "status": {"enum": ["complete", "compile_failed", "class_set_mismatch"]},
    "workspace_id": {"type": "string"},
    "build_id": {"type": "string"},
    "source_authority_sha256": {"type": "string"},
    "readable_jar_sha256": {"type": "string"},
    "namespace_id": {"type": "string"},
    "source_tree_sha256": {"type": "string"},
    "build_authority_id": {"type": "string"},
    "source_scope": {"type": "object"},
    "compiler": {"type": "object"},
    "dependency_capsule": {"type": "object"},
    "project_classes": {"type": "object"},
    "diagnostic": {"type": "string"},
    "rebuilt_client": {"type": "object"},
    "clean_project_build": {"type": "boolean"},
    "all_dependencies_rebuilt_from_source": {"type": "boolean"},
    "note": {"type": "string"}
  },
  "additionalProperties": false
}
