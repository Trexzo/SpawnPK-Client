{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Trexzo/SpawnPK-Client/schemas/source-m1-authority-artifact.schema.json",
  "title": "SpawnPK Source M1 authority artifact",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "artifact_id",
    "authority_repository",
    "authority_commit",
    "publication_repository",
    "preflight_milestone_id",
    "preflight_publishable",
    "build_id",
    "client_sha256",
    "source_tree_sha256",
    "source_file_count",
    "source_bytes",
    "document_sha256",
    "payload_file_sha256",
    "contains_binary_artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "source_m1_authority_artifact"},
    "artifact_id": {
      "type": "string",
      "pattern": "^SRCAUTHART_[0-9A-F]{20}$"
    },
    "authority_repository": {"type": "string", "minLength": 1},
    "authority_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "publication_repository": {"type": "string", "minLength": 1},
    "preflight_milestone_id": {"type": "string", "minLength": 1},
    "preflight_publishable": {"const": true},
    "build_id": {"const": "v308"},
    "client_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_file_count": {"type": "integer", "minimum": 1},
    "source_bytes": {"type": "integer", "minimum": 1},
    "document_sha256": {
      "type": "object",
      "minProperties": 9,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "payload_file_sha256": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "contains_binary_artifacts": {"const": false}
  },
  "additionalProperties": false
}
