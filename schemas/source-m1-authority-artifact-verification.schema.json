{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Trexzo/SpawnPK-Client/schemas/source-m1-authority-artifact-verification.schema.json",
  "title": "SpawnPK Source M1 authority artifact verification",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "verification_id",
    "artifact_id",
    "verified",
    "authority_commit",
    "source_tree_sha256",
    "source_file_count",
    "source_bytes",
    "payload_file_count",
    "recomputed_milestone_id",
    "milestone_error",
    "checks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "source_m1_authority_artifact_verification"},
    "verification_id": {
      "type": "string",
      "pattern": "^SRCAUTHVERIFY_[0-9A-F]{20}$"
    },
    "artifact_id": {"type": ["string", "null"]},
    "verified": {"type": "boolean"},
    "authority_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_file_count": {"type": "integer", "minimum": 0},
    "source_bytes": {"type": "integer", "minimum": 0},
    "payload_file_count": {"type": "integer", "minimum": 0},
    "recomputed_milestone_id": {"type": ["string", "null"]},
    "milestone_error": {"type": ["string", "null"]},
    "checks": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    }
  },
  "additionalProperties": false
}
