{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Trexzo/SpawnPK-Client/schemas/remap-spec.schema.json",
  "title": "SpawnPK explicit remap specification",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "build_id",
    "source_sha256",
    "classes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "remap_spec"
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "classes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^CLIENT_CLASS_[0-9]{6}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "target_internal_name",
          "confidence",
          "provenance"
        ],
        "properties": {
          "target_internal_name": {
            "type": "string",
            "pattern": "^(?!java/|javax/|jdk/|sun/)[A-Za-z_$][A-Za-z0-9_$]*(/[A-Za-z_$][A-Za-z0-9_$]*)*$"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "provenance": {
            "type": "array",
            "minItems": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
