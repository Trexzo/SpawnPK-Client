+   /**
+    * A transaction owns a fixed set of top-level entries. In particular, it
+    * does NOT own arbitrary files placed alongside the journal by an unrelated
+    * process. If unexpected data appears, retain the entire workspace for
+    * inspection rather than deleting it recursively.
+    *
+    * Journal-writing temporary files left after a sudden process stop also
+    * fail closed; these require manual review rather than being guessed safe.
+    */
+   private static void verifyWorkspaceLayout(Path work) throws IOException {
+      try (DirectoryStream<Path> entries = Files.newDirectoryStream(work)) {
+         for (Path entry : entries) {
+            String name = entry.getFileName().toString();
+            if (name.equals("staged") || name.equals("previous") ||
+                  name.equals("interrupted-new")) {
+               requirePlainDirectory(entry);
+            } else if (name.equals(MARKER) || name.equals(INSTALL_WITNESS) ||
+                  name.equals(ROLLBACK_WITNESS) || name.equals("cache.zip")) {
+               if (!Files.isRegularFile(entry, NOFOLLOW) || Files.isSymbolicLink(entry)) {
+                  throw new IOException("Unsafe cache transaction workspace entry: " + entry);
+               }
+            } else {
+               throw new IOException("Unexpected cache transaction workspace entry; " +
+                  "preserving foreign or incomplete data: " + entry);
+            }
+         }
+      }
+   }
