+   /**
+    * A committed install has no authority to discard a preexisting backup
+    * solely from the PROMOTED journal state. For v232+ transactions we have
+    * a staged digest and can prove the live tree still matches those bytes.
+    * Pre-v232 workspaces remain readable, but are explicitly witnessless.
+    */
+   private static void verifyCommittedInstallWitness(Path work, Path root) throws IOException {
+      String[] witness = readInstallWitness(work);
+      if (witness == null) return; // compatibility only for earlier journals
+      if (!witness[2].equals(snapshotFingerprint(root))) {
+         throw new IOException("Promoted cache differs from persisted installation witness; " +
+            "preserving previous cache and recovery journal: " + work);
