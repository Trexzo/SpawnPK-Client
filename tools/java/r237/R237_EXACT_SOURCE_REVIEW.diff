+   /**
+    * Recovery discards promoted or quarantined files after restoring previous/.
+    * For V2 installs those files must still match the exact staged witness.
+    * A non-cooperating writer can otherwise cause us to delete its unrelated
+    * modifications while blindly cleaning interrupted-new/ or active root.
+    * Pending V1 journals retain their historical witnessless behavior.
+    */
+   private static void verifyDiscardedInstallWitness(Path work, Path candidate) throws IOException {
+      String[] witness = readInstallWitness(work);
+      if (witness == null) return; // genuine pre-R232 legacy only
+      if (!witness[2].equals(snapshotFingerprint(candidate))) {
