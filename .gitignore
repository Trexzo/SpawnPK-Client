# Exact/proprietary client artifacts never belong in Git.
evidence/binaries/*
!evidence/binaries/.gitkeep

# Generated analysis output
generated/*
!generated/.gitkeep
reports/*
!reports/.gitkeep
evidence/indexes/*
!evidence/indexes/.gitkeep

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Raw recovered/decompiled workspaces stay out of Git. Certified Source-M1
# publications use the tracked recovered-source/<build>/ tree instead.
recovered-src/
decompiled/
*.jar
